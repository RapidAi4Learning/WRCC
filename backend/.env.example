# ── Core ──
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# ── Database ──
# postgres:// and postgresql:// URLs are auto-normalized to +asyncpg.
DATABASE_URL=postgresql+asyncpg://wrcc:wrcc@localhost:5432/wrcc
DB_POOL_SIZE=10

# ── Auth (§4a) ──
# Must be ≥32 bytes in production; placeholder is rejected there.
AUTH_SECRET=change-me-32-bytes-min
JWT_EXPIRES_MINUTES=480
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=

# Seeded admin (python -m app.db.seed fails if these are missing).
ADMIN_EMAIL=admin@wrcc.local
ADMIN_PASSWORD=change-me-strong

# ── LLM (mock-first, D3) ──
# LLM_MOCK=false requires the API key of the selected LLM_PROVIDER
# (gemini → GEMINI_API_KEY, openai → OPENAI_API_KEY).
LLM_MOCK=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── LLM latency (docs/GENERATION-LATENCY-PLAN.md) ──
# The production host kills a request at ~120 s (502), so a generation must
# finish well inside it. All of these can be tuned in cPanel without a deploy.
# Reasoning models only (gpt-5 family); blank sends nothing.
# minimal | low | medium | high — medium ≈ 23 s per post, low ≈ 7 s.
OPENAI_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=40
LLM_MAX_ATTEMPTS=2
LLM_MAX_CONCURRENCY=9
# Must stay under 115.
GENERATION_DEADLINE_SECONDS=95
IMAGE_TIMEOUT_SECONDS=100

# ── Post images (follows LLM_MOCK; live generation needs LLM_PROVIDER=openai) ──
# Generated PNGs are stored in the database (content_images.data).
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
# low | medium | high | auto — cost per image scales with quality.
IMAGE_QUALITY=medium

# ── Publishing (mock-first, D8 — see docs/PUBLISH-PLAN.md) ──
# true = deterministic offline publisher; no Meta/LinkedIn app needed.
PUBLISH_MOCK=true

# Public origin of THIS backend. Builds the OAuth redirect URIs and the image
# URLs Meta fetches server-side, so it cannot be inferred from a request.
# Needed by the connect flow even in mock mode — without it the authorize URL
# comes out relative and the browser 404s against the frontend.
# Live publishing needs a real public HTTPS origin; `ngrok http 8000` works for
# local testing against the real networks.
PUBLIC_API_BASE_URL=http://localhost:8000

# Where the social networks fetch post images from. Defaults to
# PUBLIC_API_BASE_URL, which is what you want in production: set it to a
# provider-specific hostname and cancelling that provider silently breaks
# publishing (the image 404s, and Instagram's container just fails).
#
# Set it separately only when the public host is a throwaway tunnel. An OAuth
# redirect URI has to match a value registered in a provider dashboard, so it
# wants a stable host; an image URL is only ever downloaded and is registered
# nowhere, so an ephemeral host costs nothing there.
# PUBLIC_MEDIA_BASE_URL=

# Encrypts the OAuth tokens stored in social_accounts. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Signs the public image URLs. MUST differ from AUTH_SECRET — a leaked
# image-signing key must not be able to forge sessions.
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=900

# Tuning knobs — the defaults below are what the app uses if you omit them.
# Retries fire only on throttled/transient failures; an auth failure is never
# retried, because retrying a dead token just burns quota.
PUBLISH_TIMEOUT_SECONDS=30
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_RETRY_BASE_DELAY_SECONDS=0.5
# How long a `pending` attempt may sit before it is treated as abandoned. Until
# then it blocks a retry: a lost response might mean the post did land.
PUBLISH_PENDING_STALE_SECONDS=300
# Instagram builds a media container asynchronously; this is how long we wait
# for it to finish (attempts × delay) before giving up.
INSTAGRAM_CONTAINER_POLL_ATTEMPTS=12
INSTAGRAM_CONTAINER_POLL_DELAY_SECONDS=2

# ── Meta (Facebook + Instagram) ──
# App stays in Development mode: no App Review, but only users with a role on
# the app may authorise it. The Instagram account must be a Business account
# linked to the Facebook Page.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Set when using a Facebook Login for Business configuration (then `scope` is
# omitted — business-type apps reject bare scopes as "Invalid Scopes").
META_LOGIN_CONFIG_ID=

# ── LinkedIn ──
# Company Page posting needs the Community Management API product approved on
# the LinkedIn developer portal. Falls back to member posting by setting
# LINKEDIN_AUTHOR_URN to a urn:li:person:{id}.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202506
LINKEDIN_AUTHOR_URN=

# ── Scraper ──
SCRAPER_BASE_URL=https://wrcc.nsw.edu.au
SCRAPER_REQUEST_DELAY_MS=500
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_SECONDS=20
